{
  "env": {
    "GIT_CONFIG_COUNT": "2",
    "GIT_CONFIG_KEY_0": "credential.https://github.com.helper",
    "GIT_CONFIG_VALUE_0": "",
    "GIT_CONFIG_KEY_1": "credential.https://github.com.helper",
    "GIT_CONFIG_VALUE_1": "!cargo xtask git-credential"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNetworkIsolation": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "static.rust-lang.org",
        "api.osv.dev"
      ],
      "allowUnixSockets": [
        "~/.config/abc/agent-broker/broker.sock"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Bash(gh auth token)",
      "Bash(gh auth token *)",
      "Bash(gh auth status --show-token)",
      "Bash(gh auth status --show-token *)",
      "Bash(gh auth status * --show-token*)",
      "Bash(gh auth status -t)",
      "Bash(gh auth status -t *)",
      "Bash(gh auth status * -t*)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Cookies/**)",
      "Read(~/Library/Safari/**)",
      "Read(~/Library/Application Support/Google/**)",
      "Read(~/Library/Application Support/Chromium/**)",
      "Read(~/Library/Application Support/BraveSoftware/**)",
      "Read(~/Library/Application Support/Arc/**)",
      "Read(~/Library/Application Support/Microsoft Edge/**)",
      "Read(~/Library/Application Support/Vivaldi/**)",
      "Read(~/Library/Application Support/com.operasoftware.Opera/**)",
      "Read(~/Library/Application Support/Firefox/**)",
      "Read(~/Library/Application Support/Mozilla/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/abc/agent-app/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/**)",
      "Read(~/.colima/**)",
      "Read(~/.terraform.d/**)",
      "Read(~/.supabase/**)",
      "Read(~/.codex/**)",
      "Read(~/.gemini/**)",
      "Read(~/.copilot/**)",
      "Read(~/.mcp-auth/**)",
      "Read(~/.factory/**)",
      "Read(~/.config/anthropic/**)",
      "Read(~/.config/amp/**)",
      "Read(~/.config/opencode/**)",
      "Read(~/.config/devin/**)",
      "Read(~/.config/elevenlabs/**)",
      "Read(~/.config/code-server/**)",
      "Read(~/.logfire/**)",
      "Read(~/.zsh_sessions/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.npmrc)",
      "Read(~/.yarnrc)",
      "Read(~/.yarnrc.yml)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/.cargo/credentials)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)",
      "Read(~/.python_history)",
      "Read(~/.node_repl_history)"
    ],
    "ask": [
      "Edit(/.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/jail.sh\" ] && [ -f \"$CLAUDE_PROJECT_DIR/xtask/hooks/pre-tool-use.sh\" ]; then cd \"$CLAUDE_PROJECT_DIR\" && sh .claude/hooks/jail.sh sh xtask/hooks/pre-tool-use.sh; else echo \"xtask hook: $CLAUDE_PROJECT_DIR has no .claude/hooks/jail.sh or xtask/hooks/pre-tool-use.sh; the git guard is off\" >&2; fi",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.sh\" ] && [ -f \"$CLAUDE_PROJECT_DIR/xtask/Cargo.toml\" ]; then sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.sh\"; else echo \"xtask hook: $CLAUDE_PROJECT_DIR has no .claude/hooks/stop.sh or xtask; no checks run\" >&2; fi",
            "timeout": 900,
            "statusMessage": "cargo xtask check --changed"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(?!(?:Explore|Plan|claude-code-guide|statusline-setup|web-fetch)$).+",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.sh\" ] && [ -f \"$CLAUDE_PROJECT_DIR/xtask/Cargo.toml\" ]; then sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.sh\"; else echo \"xtask hook: $CLAUDE_PROJECT_DIR has no .claude/hooks/stop.sh or xtask; no checks run\" >&2; fi",
            "timeout": 900,
            "statusMessage": "cargo xtask check --changed"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true,
    "egm@egm": true
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    },
    "egm": {
      "source": {
        "source": "github",
        "repo": "google/elephant-goldfish-model"
      }
    }
  }
}
