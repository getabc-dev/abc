# The agent VM's image (`cargo xtask vm image`, D37): Debian with the pinned Rust toolchain, the
# repository's pinned tools, Postgres 18.6 from the image CI uses, Playwright's Chromium, git, gh
# and Claude Code. Built
# from the repository root by Apple's `container` on macOS or Docker on Linux, then loaded into
# microsandbox.

# Postgres comes from the image CI and the warm container use (xtask/src/postgres.rs).
FROM docker.io/library/postgres:18.6@sha256:3a4264520e121176619f54ff867d12774bc81e95e7b84db58d63bccdb6144b81 AS postgres

FROM docker.io/library/debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4

ARG CLAUDE_CODE_VERSION=2.1.316
ARG RUSTUP_VERSION=1.28.2
# The `@playwright/test` web/package.json pins; an xtask test keeps the two equal.
ARG PLAYWRIGHT_VERSION=1.64.1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git gh build-essential pkg-config socat util-linux procps less \
      nodejs npm libicu76 libxml2 libssl3t64 libldap2 libgssapi-krb5-2 libpam0g libsystemd0 \
      libzstd1 liblz4-1 libnuma1 liburing2 libllvm19 \
 && rm -rf /var/lib/apt/lists/*

# The system libraries and fonts Playwright's Chromium needs for the end-to-end tests
# (`cargo xtask e2e`), as `playwright install --with-deps chromium` installs them on Debian 13.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libnss3 libnspr4 libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64 libcups2t64 \
      libdbus-1-3 libdrm2 libgbm1 libglib2.0-0t64 libxkbcommon0 libx11-6 libxcb1 libxext6 \
      libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libpango-1.0-0 libcairo2 libasound2t64 \
      fonts-liberation fonts-noto-color-emoji \
 && rm -rf /var/lib/apt/lists/*

# Claude Code, pinned; it changes only when the image is rebuilt (DISABLE_AUTOUPDATER in the VM).
RUN npm install -g --no-fund --no-audit "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
 && npm cache clean --force

# The agent's user. The worktree appears owned by it (xtask/src/vm/msb.rs mounts it as uid 1000).
RUN useradd --create-home --uid 1000 --shell /bin/bash agent

# Playwright's Chromium for the end-to-end tests, installed when the image is built: agent VMs
# never download browsers, and their egress list has no browser host. It lives in a fixed
# PLAYWRIGHT_BROWSERS_PATH, which the image's environment sets for every session, so the
# `playwright install chromium` that `cargo xtask e2e` runs finds it and downloads nothing. The
# agent owns the directory, where Playwright records which installations use its browsers.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN install -d -o agent -g agent "$PLAYWRIGHT_BROWSERS_PATH"
USER agent
RUN npm exec --yes --no-fund --no-audit --package="@playwright/test@${PLAYWRIGHT_VERSION}" -- \
      playwright install chromium \
 && npm cache clean --force
USER root

# Postgres 18.6 and its libpq 18 (Debian's libpq5 is 17), run by the entrypoint.
COPY --from=postgres /usr/lib/postgresql /usr/lib/postgresql
COPY --from=postgres /usr/share/postgresql /usr/share/postgresql
COPY --from=postgres /usr/lib/*-linux-gnu/libpq.so.5* /usr/local/lib/
RUN ldconfig \
 && useradd --system --home-dir /var/lib/postgresql --shell /usr/sbin/nologin postgres \
 && for b in postgres initdb pg_ctl psql; do \
      ! ldd /usr/lib/postgresql/18/bin/$b | grep 'not found' || exit 1; done \
 && install -d -o postgres -g postgres -m 2775 /run/postgresql

# Rust, with the toolchain rust-toolchain.toml pins, owned by the agent so rustup and cargo can
# write their caches.
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN mkdir -p /opt/rustup /opt/cargo && chown agent:agent /opt/rustup /opt/cargo
USER agent
RUN arch="$(uname -m)-unknown-linux-gnu" \
 && base="https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${arch}" \
 && curl -fsSLo /tmp/rustup-init "$base/rustup-init" \
 && curl -fsSL "$base/rustup-init.sha256" | awk '{print $1"  /tmp/rustup-init"}' | sha256sum -c - \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain none \
 && rm /tmp/rustup-init
COPY --chown=agent:agent rust-toolchain.toml /opt/abc-src/rust-toolchain.toml
RUN cd /opt/abc-src && rustup toolchain install

# The crates of both workspaces (the main one and xtask's own) and the pinned tools, so a session
# starts without downloading them, and xtask itself for the one check the VM runs with code the
# agent cannot change: `abc-xtask vm billing`, before the session and before every tool call. The
# hooks build and run the checkout's own xtask, never this one. `cargo xtask setup` checks
# every sha256 as on any machine; each session copies the tools into its own volume at the
# worktree's .tools/ (entrypoint.sh).
COPY --chown=agent:agent Cargo.toml Cargo.lock /opt/abc-src/
COPY --chown=agent:agent .cargo /opt/abc-src/.cargo
COPY --chown=agent:agent .config /opt/abc-src/.config
COPY --chown=agent:agent crates /opt/abc-src/crates
COPY --chown=agent:agent xtask /opt/abc-src/xtask
RUN cd /opt/abc-src \
 && cargo fetch --locked \
 && cargo fetch --locked --manifest-path xtask/Cargo.toml \
 && CARGO_TARGET_DIR=/tmp/xtask-target cargo xtask setup \
 && CARGO_TARGET_DIR=/tmp/xtask-target cargo xtask doctor \
 && cp /tmp/xtask-target/debug/xtask /opt/abc-src/abc-xtask \
 && rm -rf /tmp/xtask-target

USER root
RUN mv /opt/abc-src/.tools /opt/abc-tools \
 && install -m 755 /opt/abc-src/abc-xtask /usr/local/bin/abc-xtask \
 && install -m 755 /opt/abc-src/xtask/vm/entrypoint.sh /usr/local/bin/abc-entrypoint \
 && install -m 755 /opt/abc-src/xtask/vm/agent-exec /usr/local/bin/agent-exec \
 && install -m 755 /opt/abc-src/xtask/vm/own-disks /usr/local/bin/abc-own-disks \
 && install -m 644 /opt/abc-src/xtask/vm/gitconfig /etc/gitconfig \
 && find / -xdev -perm /6000 -type f -exec chmod ug-s {} +
ENTRYPOINT ["/usr/local/bin/abc-entrypoint"]
