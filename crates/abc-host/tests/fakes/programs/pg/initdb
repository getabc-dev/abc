#!/bin/sh
# A stand-in for Postgres 18's initdb: makes a cluster directory that says it is 18.
#
# Models: Postgres 18's initdb (checked against the real one in tests/fakes.rs). Environment: none
# read. Streams: the error is on stderr. Exit codes: 0 with a PG_VERSION of 18 in --pgdata; 1
# without --pgdata.
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
# shellcheck source-path=SCRIPTDIR source=../../bin/lib.sh
. "$ROOT/bin/lib.sh"
record initdb "$@"
while [ "$#" -gt 0 ]; do
	if [ "$1" = --pgdata ]; then
		mkdir -p "$2"
		chmod 700 "$2"
		echo 18 >"$2/PG_VERSION"
		exit 0
	fi
	shift
done
echo "initdb: no data directory specified" >&2
exit 1
