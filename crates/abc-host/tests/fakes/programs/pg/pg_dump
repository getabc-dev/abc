#!/bin/sh
# A stand-in for pg_dump: writes what abc's database holds to --file.
#
# Models: pg_dump. Environment: none read. Streams: writes the dump to --file, nothing on stdout.
# Exit codes: 0; 1 without --file.
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
# shellcheck source-path=SCRIPTDIR source=../../bin/lib.sh
. "$ROOT/bin/lib.sh"
record pg_dump "$@"
while [ "$#" -gt 0 ]; do
	if [ "$1" = --file ]; then
		printf 'FAKE DUMP\n%s\n' "$(cat "$STATE/db-abc")" >"$2"
		exit 0
	fi
	shift
done
exit 1
