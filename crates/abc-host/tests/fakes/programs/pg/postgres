#!/bin/sh
# A stand-in for Postgres 18's server: says its version, or records how it was started and runs
# until stopped.
#
# Models: Postgres 18's server (checked against the real one in tests/fakes.rs). Environment:
# needs LC_ALL, as on macOS, or it exits with the real message. Streams: --version prints on
# stdout; the FATAL is on stderr. Exit codes: 0 for --version; 1 without LC_ALL; otherwise it
# never exits by itself.
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
# shellcheck source-path=SCRIPTDIR source=../../bin/lib.sh
. "$ROOT/bin/lib.sh"
if [ "$1" = --version ]; then
	echo "postgres (PostgreSQL) 18.1"
	exit 0
fi
record postgres "$@"
# As on macOS, where the postmaster refuses to start without a locale in its environment: setlocale
# would start threads (Homebrew's own service sets LC_ALL for this).
if [ -z "${LC_ALL:-}" ]; then
	echo "FATAL:  postmaster became multithreaded during startup" >&2
	echo "HINT:  Set the LC_ALL environment variable to a valid locale." >&2
	exit 1
fi
echo "$$" >"$STATE/postgres.daemon"
exec sleep 86400
