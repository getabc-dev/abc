#!/bin/sh
# A stand-in for abc's tailscaled: records how it was started and runs until stopped.
#
# Models: tailscaled. Environment: needs TS_LOGS_DIR to name a directory, as the real one without
# it falls back to the system's state directory beside the user's own Tailscale. Streams: that
# complaint is on stderr. Exit codes: 1 without TS_LOGS_DIR; otherwise it never exits by itself.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source-path=SCRIPTDIR source=../bin/lib.sh
. "$ROOT/bin/lib.sh"
record tailscaled "$@"
# Without TS_LOGS_DIR, tailscaled keeps its log state in the system's Tailscale directory
# (/var/db/tailscale, /var/lib/tailscale) when it exists, beside the user's own Tailscale.
if [ -z "${TS_LOGS_DIR:-}" ] || [ ! -d "$TS_LOGS_DIR" ]; then
	echo "logpolicy: using system state directory \"/var/lib/tailscale\"" >&2
	exit 1
fi
echo "$$" >"$STATE/tailscaled.daemon"
exec sleep 86400
