#!/bin/sh
# A stand-in for launchctl: bootstrap, bootout, print and kickstart of gui/<uid> agents. It runs
# each agent's ProgramArguments with its EnvironmentVariables, as read from the plist, so a plist
# abc writes wrong fails the test. With state/bootout-lingers, a booted-out agent is still
# unloading when the next bootstrap of it comes, which then fails once, as launchd's does; with
# state/bootstrap-refuses, every bootstrap fails.
#
# Models: launchd's launchctl for gui/<uid> user agents. Environment: an agent runs with only its
# plist's EnvironmentVariables, the test's state/extra.env and PATH=/usr/bin:/bin, never the
# caller's environment, as launchd starts a job, with stdin /dev/null. Streams: the agent's stdout
# and stderr go to state/LABEL.log; launchctl's own errors go to stderr, a `print` to stdout. Exit
# codes: 0; 5 to bootstrap an agent that is loaded or still unloading; 125 when refused; 3 to
# bootout an agent that is not loaded; 113 to print or kickstart one that is unknown; 64 for any
# other command.
ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$ROOT/bin/lib.sh"
record launchctl "$@"

# read_plist PLIST LABEL: the agent's arguments and environment into state/LABEL.args and .env.
read_plist() {
	awk -v args="$STATE/$2.args" -v env="$STATE/$2.env" '
		function inner(line) { sub(/^[ \t]*<[a-z]+>/, "", line); sub(/<\/[a-z]+>[ \t]*$/, "", line); return line }
		/<key>ProgramArguments<\/key>/ { mode = "args"; next }
		/<key>EnvironmentVariables<\/key>/ { mode = "env"; next }
		mode == "args" && /<\/array>/ { mode = ""; next }
		mode == "env" && /<\/dict>/ { mode = ""; next }
		mode == "args" && /<string>/ { print inner($0) > args }
		mode == "env" && /<key>/ { key = inner($0) }
		mode == "env" && /<string>/ { print key "=" inner($0) > env }
	' "$1"
	touch "$STATE/$2.env"
	for file in "$STATE/$2.args" "$STATE/$2.env"; do
		sed -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&quot;/"/g' -e "s/&apos;/'/g" -e 's/&amp;/\&/g' \
			"$file" >"$file.new"
		mv "$file.new" "$file"
	done
}

label_of() {
	printf '%s\n' "${1##*/}"
}

case "$1" in
bootstrap)
	label=$(basename "$3" .plist)
	if [ -f "$STATE/bootstrap-refuses" ]; then
		echo "Bootstrap failed: 125: Domain does not support specified action" >&2
		exit 125
	fi
	if [ -f "$STATE/$label.unloading" ]; then
		rm -f "$STATE/$label.unloading"
		echo "Bootstrap failed: 5: Input/output error" >&2
		exit 5
	fi
	if [ -f "$STATE/$label.loaded" ]; then
		echo "Bootstrap failed: 5: Input/output error" >&2
		exit 5
	fi
	read_plist "$3" "$label"
	touch "$STATE/$label.loaded"
	start "$label"
	;;
bootout)
	label=$(label_of "$2")
	if [ ! -f "$STATE/$label.loaded" ]; then
		echo "Boot-out failed: 3: No such process" >&2
		exit 3
	fi
	stop "$label"
	rm -f "$STATE/$label.loaded"
	if [ -f "$STATE/bootout-lingers" ]; then
		touch "$STATE/$label.unloading"
	fi
	;;
print)
	label=$(label_of "$2")
	if [ ! -f "$STATE/$label.loaded" ]; then
		echo "Could not find service \"$label\" in domain for user gui" >&2
		exit 113
	fi
	printf '%s = {\n' "gui/501/$label"
	if running "$label"; then
		echo "	state = running"
	else
		echo "	state = not running"
	fi
	echo "}"
	;;
kickstart)
	if [ "$2" = -k ]; then
		label=$(label_of "$3")
	else
		label=$(label_of "$2")
	fi
	if [ ! -f "$STATE/$label.loaded" ]; then
		echo "Could not find service \"$label\" in domain for user gui" >&2
		exit 113
	fi
	if [ "$2" = -k ]; then
		stop "$label"
	fi
	start "$label"
	;;
*)
	echo "the fake launchctl does not know $1" >&2
	exit 64
	;;
esac
