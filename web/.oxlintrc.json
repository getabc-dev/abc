{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-perf",
    "jsx-a11y",
    "unicorn",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    // React 19's JSX transform imports what JSX needs; React need not be in scope.
    "react/react-in-jsx-scope": "off",
    // TypeScript checks every path returns (noImplicitReturns), and an exhaustive switch over a
    // union needs no return after it.
    "typescript/consistent-return": "off",
    // A closure passed as a prop is idiomatic React; memoizing every handler costs clarity and
    // buys nothing at this size.
    "react-perf/jsx-no-new-function-as-prop": "off",
    // Base UI composes through a `render` prop that takes an element (`render={<Link />}`), which
    // is how shadcn/ui's components are meant to be used.
    "react-perf/jsx-no-jsx-as-prop": "off",
    // Stylesheets are imported for their effect.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "eqeqeq": "error",
    "no-console": "error"
  },
  "ignorePatterns": [
    "dist",
    "coverage",
    "test-results",
    "playwright-report",
    "src/generated",
    "src/routeTree.gen.ts",
    // shadcn/ui's registry files, kept as `shadcn add` writes them (DESIGN.md): tsc, knip and the
    // tests check them; lint rules written for abc's own code would make each refresh a fork.
    "src/components/ui",
    "src/hooks/use-mobile.ts"
  ]
}
