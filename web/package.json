{
  "name": "@abc/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "biome": "biome ci --error-on-warnings",
    "oxlint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
